# 1. Directory Protection & Performance
Options -Indexes
Options +FollowSymLinks

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 2. Hostinger Specific: Allow Authorization Headers to pass through
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

    # 3. Clean trailing slashes & double slashes internally
    RewriteCond %{REQUEST_URI} ^(.*)//(.*)$
    RewriteRule . %1/%2 [R=301,L]

    # 4. Block sensitive files (Security)
    RewriteRule ^(\.env|\.git|composer\.json|composer\.lock|README\.md) - [F,L,NC]

    # 5. Route Static Files (Images)
    # If the request is for the uploads folder and the file exists, serve it directly!
    RewriteCond %{REQUEST_URI} ^/uploads/ [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 6. Route all API requests and fallbacks to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# 7. Add Cache Headers for Images (Performance)
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|webp)$">
        Header set Cache-Control "max-age=2592000, public"
        # Allow cross-origin access to images if needed by canvas/cropper
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>
