PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/STONA?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key
NODE_ENV=development

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Master Admin
MASTER_ADMIN_EMAIL="master@gmail.com"
MASTER_ADMIN_PASSWORD="your_password"

# Allowed Origins (Comma separated or space separated depending on config, here we will map it like Node)
ADMIN_APP_URL=http://localhost:5174
FRONTEND_URL=http://localhost:5173
CUSTOMER_FRONTEND_URL=http://localhost:5173
API_SERVER_URL=http://localhost:5000
