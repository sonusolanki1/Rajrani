{
    "name": "rajputana/backend-php",
    "description": "Pure PHP Backend for Rajputana",
    "type": "project",
    "require": {
        "php": "^8.3",
        "mongodb/mongodb": "^2.3",
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "^6.10",
        "bramus/router": "^1.6",
        "cocur/slugify": "^4.3",
        "phpmailer/phpmailer": "^6.9",
        "guzzlehttp/guzzle": "^7.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "audit": {
            "block-insecure": false
        }
    }
}
